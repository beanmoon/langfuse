# Edge in front of Langfuse Web. Two jobs:
#   1. Proxy the Web/API on /.
#   2. Proxy the S3-compatible object store (MinIO) under /<bucket>/ so that
#      presigned media URLs are same-origin with the UI. The prebuilt Web image
#      bakes `media-src 'self' ...`, so same-origin media needs no CSP override
#      and MinIO never has to be exposed publicly.
#
# S3 v4 presigned URLs sign the Host header and the URI path, so we preserve
# both: `proxy_pass` without a trailing slash keeps the full path, and
# `Host $http_host` keeps the host the browser sent (which is the host the
# presigned URL was signed against). Bucket prefix must match
# LANGFUSE_S3_BUCKET in .env.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    client_max_body_size 100m;

    # MinIO S3 API. Path is /<bucket>/<key>; route the whole bucket prefix.
    location /langfuse/ {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://langfuse-web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
